{
  "name": "beasty-arr",
  "version": "0.4.15",
  "description": "German-hunting companion for Sonarr/Radarr: budget-aware forced searches until everything has German audio",
  "main": "dist/server/server/index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "portless",
    "dev:app": "infisical run --env=dev --path=/ -- concurrently -k -n prowlarr,api,web \"kubectl port-forward --address 127.0.0.1 -n media service/prowlarr 19696:9696\" \"API_PORT=3001 tsx watch src/server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "deadcode": "knip --include files,dependencies,unlisted,binaries,unresolved --no-config-hints",
    "static": "pnpm lint && pnpm typecheck && pnpm deadcode",
    "secrets": "gitleaks git --no-banner --redact",
    "secrets:staged": "gitleaks git --staged --no-banner --redact",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "format": "biome format --write .",
    "check": "pnpm static && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate",
    "prepare": "lefthook install"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@earendil-works/pi-ai": "^0.80.10",
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@fastify/helmet": "^13.1.0",
    "@fastify/static": "^10.1.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.0",
    "lucide-react": "^1.28.0",
    "nanoid": "^6.0.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typebox": "1.1.38",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "knip": "^6.31.0",
    "lefthook": "^2.1.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.3.0"
}
