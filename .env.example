# Start without integrations. Uncomment each URL/key pair together when ready.
# SONARR_URL=http://sonarr:8989
# SONARR_API_KEY=replace-with-your-key
# SONARR_EXTERNAL_URL=https://sonarr.example.com
# RADARR_URL=http://radarr:7878
# RADARR_API_KEY=replace-with-your-key
# RADARR_EXTERNAL_URL=https://radarr.example.com
# PROWLARR_URL=http://prowlarr:9696
# PROWLARR_API_KEY=replace-with-your-key

PORT=9898
DATA_DIR=./data
TZ=Europe/Berlin
LOG_LEVEL=info

# Optional SearXNG JSON search for Oracle research and both Fixer services.
# Enable json in SearXNG search.formats and allow service/public-web egress.
# Fixer web_fetch is available without search and only reads public HTTP(S) pages.
# SEARXNG_URL=http://searxng.tools.svc.cluster.local:8080
PI_INFERENCE_TIMEOUT_MS=900000
# Abort and retry an AI attempt that produces no session event for this long.
# PI_STALL_TIMEOUT_MS=300000

# Optional read-only media probing for the fixer (ffprobe on the real file).
# Maps arr-reported path prefixes to where the media volume is mounted here:
# FROM=TO[,FROM2=TO2], absolute paths. Leave unset to disable probing.
# FIXER_MEDIA_PATH_MAP=/data=/arr-data

# Optional production-only telemetry. pnpm dev never sends telemetry.
# UMAMI_URL=https://umami.example.com
# UMAMI_WEBSITE_ID=your-website-id
# Required hostname allowlist. Analytics stays disabled when any Umami value is missing.
# UMAMI_DOMAINS=beasty-arr.example.com
# GLITCHTIP_DSN=https://public-key@glitchtip.example.com/1
# GLITCHTIP_ENVIRONMENT=production
